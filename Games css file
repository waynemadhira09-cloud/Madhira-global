* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 20px;
    font-family: Arial, sans-serif;
    background: #07101f;
    color: white;
}

.games-container {
    max-width: 600px;
    margin: 0 auto;
}

h1 {
    text-align: center;
    margin-top: 20px;
}

.subtitle {
    text-align: center;
    color: #8fa0dd;
    margin-bottom: 25px;
}

.games-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.game-card {
    min-height: 160px;
    border: none;
    border-radius: 15px;
    background: #131c2e;
    color: white;
    padding: 20px;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
}

.game-card:hover {
    transform: translateY(-2px);
}

.game-icon {
    font-size: 45px;
    margin-bottom: 10px;
}

.game-card h2 {
    margin: 5px 0;
}

.game-card p {
    color: #8fa0dd;
    margin: 5px 0;
}

@media (max-width: 500px) {
    .games-grid {
        grid-template-columns: 1fr 1fr;
    }
}
/* ==============================
   AVIATOR GAME
============================== */

#aviator-game {
    display: none;
    margin-top: 20px;
}

.back-button {
    border: none;
    background: #1e2d4a;
    color: white;
    padding: 10px 15px;
    border-radius: 8px;
    cursor: pointer;
    margin-bottom: 15px;
}

.aviator-game h2 {
    text-align: center;
    margin-bottom: 15px;
}

.aviator-screen {
    height: 350px;
    position: relative;
    overflow: hidden;

    border-radius: 15px;

    background:
        radial-gradient(
            circle at center,
            #243b64,
            #101a2d 55%,
            #050b14
        );

    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

#aviator-multiplier {
    font-size: 55px;
    font-weight: bold;
    z-index: 2;
}

#aviator-plane {
    position: absolute;
    left: 30px;
    bottom: 35px;

    font-size: 50px;

    transition:
        left 0.1s linear,
        bottom 0.1s linear;
}

#aviator-status {
    color: #8fa0dd;
    margin-top: 10px;
    z-index: 2;
}

.demo-balance {
    background: #131c2e;
    padding: 15px;
    border-radius: 10px;
    margin-top: 15px;
    text-align: center;
    color: #8fa0dd;
}

.demo-balance strong {
    color: #4ade80;
    font-size: 20px;
}

.aviator-controls {
    margin-top: 15px;
}

#aviator-bet {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 8px;

    background: #131c2e;
    color: white;

    font-size: 16px;
    outline: none;
}

#start-button,
#cashout-button {
    width: 100%;
    padding: 14px;
    margin-top: 10px;

    border: none;
    border-radius: 8px;

    color: white;
    font-size: 16px;
    font-weight: bold;

    cursor: pointer;
}

#start-button {
    background: #2563eb;
}

#cashout-button {
    background: #16a34a;
}

#cashout-button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}
